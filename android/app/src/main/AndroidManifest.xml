<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      What this app asks for, and what it deliberately does not.

      INTERNET is here because the app has to upload. ACCESS_NETWORK_STATE is
      not: the app never asks "am I online", it just tries, and reports what
      happened. Asking is a permission spent on a worse answer.

      There is no ACCESS_BACKGROUND_LOCATION. Position is read while a report
      is open on screen, and — from 1.6 — while a route the analyst started by
      hand is being recorded, by a foreground service that shows a
      notification for every second it runs and stops when they press Stop.
      Nothing records a position without the analyst asking and the phone
      saying so.

      There is no READ_EXTERNAL_STORAGE / READ_MEDIA_IMAGES. Photos and clips
      are captured by this app into its own sandbox. It cannot read the
      gallery, which means a seized phone's gallery is not something this app
      can be made to exfiltrate.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The route recorder (track/RouteRecorderService.kt). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Keeps the processor awake while a route records with the screen off,
         so GPS fixes are delivered rather than held until the phone wakes. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The team relay (relay/RelayService.kt): a tablet taking reports from
         the team's phones over its own hotspot, all night. "specialUse"
         because no defined type covers a local server for one's own team,
         and dataSync is limited to six hours a day on Android 15. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- So the "Recording a route" notification can be seen. Asked for when
         a recording starts; refused, the recording still runs. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <application
        android:name=".FieldApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HumintField"
        android:localeConfig="@xml/locales_config">

        <!--
          android:allowBackup="false" and the extraction rules together keep
          the encrypted database out of cloud backup and out of device-to-
          device transfer. The queue is meant to exist on exactly one handset
          until it is uploaded and deleted.

          excludeFromRecents is not set, but FLAG_SECURE is applied in
          MainActivity: the recents thumbnail of a half-written report about
          somebody is not a thing to leave lying around.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".track.RouteRecorderService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".relay.RelayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Receives field reports from the user's own team's phones over the tablet's Wi-Fi hotspot while the team is deployed, for later upload to their self-hosted server." />
        </service>
    </application>
</manifest>
