#!/usr/bin/env bash
# Operator command for the HUMINT field server. Run it over SSH or on the
# console. Everything the little screen shows, plus the things you cannot do
# from a screen: switch network mode, change the PIN, re-lock the case file
# without a reboot, and bring the console up or down.
set -euo pipefail
# shellcheck source=/dev/null
. /opt/humint/lib/humint-common.sh

# Almost everything here touches root-only state (the saved config holds the
# Wi-Fi passphrase), so elevate once, with the full original command line.
case "${1:-}" in -h|--help|help) ;; *)
    [ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@" ;;
esac
load_config "$HUMINT_ENV"

need_root() { :; }   # already root (see above); kept so call sites read clearly

usage() {
    cat <<EOF
humint-ctl — HUMINT field server

  status                 network, services and system at a glance
  url                    just the address to hand the team
  screen "L1" "L2" ...   write a message to the OLED

  up | down | restart    the console (database, API, worker)
  lock                   stop the console and re-lock the case file now
  backup [DIR]           dump the case database to DIR (default: the store)

  net hotspot            switch to being the Wi-Fi access point
  net client SSID [PSK]  join an existing Wi-Fi and serve on it
  net wired              Ethernet only, Wi-Fi off
  pin                    change the unlock PIN
  duress set | clear     a second PIN that, typed at unlock, erases the case
                         file and opens an empty one as if nothing were wrong
  duress                 whether one is set
  wipe                   erase the case file for good; back to first-time setup
  login-password         give the operator login a new random password
                         (printed here and shown on the panel until confirmed)
  tls                    HTTPS status and the certificate fingerprint
  tls renew              issue a fresh server certificate now
  tls on | off           serve HTTPS (default) or plain HTTP
  battery                charge, voltage and current (UPS HAT)
  screen-detect          what screen is attached, and what it will show

  shutdown | reboot      power off / restart safely
  logs [api|worker|db|firstboot|unlock]   follow a service's log
EOF
}

cmd_status() {
    local url
    url="$(console_url)"
    echo "Host     : $(hostname) (${HOSTNAME}.local)"
    echo "URL      : $url"
    if [ "${TLS:-on}" = on ]; then
        echo "Trust    : http://${HOSTNAME}.local/trust  (install the certificate once per device)"
    fi
    case "${NET_MODE:-}" in
        hotspot) echo "Network  : hotspot — SSID '${AP_SSID}' (${AP_BAND})";;
        client)  echo "Network  : client — '${CLIENT_SSID}'";;
        wired)   echo "Network  : wired${WIRED_DHCP_SERVER:+ (serving DHCP)}";;
    esac
    if mountpoint -q "$HUMINT_DATA"; then
        echo "Case file: OPEN"
        local free; free="$(df -h --output=avail "$HUMINT_DATA" 2>/dev/null | tail -1 | tr -d ' ')"
        echo "Free     : ${free:-?} on the case store"
    else
        echo "Case file: LOCKED"
    fi
    echo "Services :"
    local unit
    for unit in "$PG_UNIT" humint-api.service humint-worker.service humint-http.service; do
        printf '  %-26s %s\n' "$unit" "$(systemctl is-active "$unit" 2>/dev/null || true)"
    done
    if [ -f /run/humint/battery.json ]; then
        /usr/bin/python3 - <<'PY2'
import json
b = json.load(open("/run/humint/battery.json"))
if b.get("present"):
    how = ("on battery" if b.get("on_battery") else
           "plugged in, charging" if b.get("charging") else
           "plugged in" if b.get("ac_present") else "source unknown")
    left = b.get("minutes_left")
    extra = f", ~{left // 60}h{left % 60:02d}m left" if left is not None else ""
    print(f"Power    : {b.get('board', 'battery')} {b['percent']:.0f}% ({how}{extra}, {b['voltage']:.2f} V)")
elif b.get("mains"):
    print("Power    : external (AC) — no battery module fitted")
PY2
    fi
    local t; t="$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || true)"
    [ -n "$t" ] && echo "Temp     : $((t / 1000)) C"
}

cmd_net() {
    need_root "$@"
    local mode="${1:-}"; shift || true
    case "$mode" in
        hotspot) sed -i 's/^NET_MODE=.*/NET_MODE=hotspot/' "$HUMINT_ENV" ;;
        client)
            local ssid="${1:-}" psk="${2:-}"
            [ -n "$ssid" ] || die "net client needs an SSID"
            sed -i 's/^NET_MODE=.*/NET_MODE=client/' "$HUMINT_ENV"
            sed -i "s/^CLIENT_SSID=.*/CLIENT_SSID=$ssid/" "$HUMINT_ENV"
            sed -i "s/^CLIENT_PSK=.*/CLIENT_PSK=$psk/" "$HUMINT_ENV"
            ;;
        wired)   sed -i 's/^NET_MODE=.*/NET_MODE=wired/' "$HUMINT_ENV" ;;
        *) die "net needs: hotspot | client SSID [PSK] | wired" ;;
    esac
    /opt/humint/bin/humint-net.sh deploy
    echo "Network switched to $mode."
}

cmd_pin() {
    need_root "$@"
    mountpoint -q "$HUMINT_DATA" || die "unlock the case file first (it must be open to change its PIN)"
    echo "Changing the unlock PIN. Enter the current PIN, then the new one."
    cryptsetup luksChangeKey "$HUMINT_IMG"
    echo "PIN changed."
}

read_secret_twice() {   # read_secret_twice "Prompt" -> stdout
    local a b
    IFS= read -rs -p "$1: " a </dev/tty; echo >/dev/tty
    IFS= read -rs -p "Again: " b </dev/tty; echo >/dev/tty
    [ "$a" = "$b" ] || die "they did not match"
    printf '%s' "$a"
}

cmd_duress() {
    need_root "$@"
    local dur=/opt/humint/bin/humint-duress.py
    case "${1:-}" in
        set)
            # Exit codes (the panel turns them into messages): 1 cancelled,
            # 3 that is the real PIN, 4 too short, 5 no case file.
            [ -f "$HUMINT_IMG" ] || { echo "there is no case file yet" >&2; exit 5; }
            local pin
            if [ "${2:-}" = "--panel" ]; then
                pin="$(panel_ask_pin duress)" || exit 1
            else
                pin="$(read_secret_twice "Duress PIN")"
            fi
            [ "${#pin}" -ge "$PIN_MIN_LENGTH" ] || { echo "use at least $PIN_MIN_LENGTH characters" >&2; exit 4; }
            if printf '%s' "$pin" | cryptsetup open --test-passphrase --key-file=- "$HUMINT_IMG" 2>/dev/null; then
                echo "that is the real PIN — the duress PIN must be a different one" >&2; exit 3
            fi
            printf '%s\n' "$pin" | /usr/bin/python3 "$dur" set
            unset pin
            echo "Duress PIN set. Typed at unlock, it erases the case file and opens an empty one."
            echo "Choose one nobody types by accident — not a near-miss of the real PIN." ;;
        clear) /usr/bin/python3 "$dur" clear; echo "Duress PIN removed." ;;
        ""|status)
            if /usr/bin/python3 "$dur" status; then echo "A duress PIN is set."; else echo "No duress PIN."; fi ;;
        *) die "duress: set | clear | status" ;;
    esac
}

cmd_wipe() {
    need_root "$@"
    if [ "${1:-}" != "--yes" ]; then
        echo "This ERASES the case file on this box for good — every record, report and file."
        echo "Copies elsewhere (USB backups, exported packages, other devices) are not touched."
        local answer; IFS= read -r -p "Type WIPE to continue: " answer </dev/tty
        [ "$answer" = WIPE ] || die "not wiped"
    fi
    exec /opt/humint/bin/humint-wipe.sh reset
}

cmd_lock() {
    need_root "$@"
    lock_store
    echo "Case file re-locked. Reboot (or: systemctl restart humint-unlock) to open it again."
}

cmd_up() {
    need_root "$@"
    data_ready || die "the case file is locked — reboot, or: systemctl restart humint-unlock"
    start_console
}

cmd_backup() {
    need_root "$@"
    data_ready || die "the case file is locked"
    local dir="${1:-$HUMINT_DATA/backups}" f
    install -d -m 700 "$dir"
    f="$dir/humint-db-$(date +%Y%m%d-%H%M%S).dump"
    runuser -u postgres -- pg_dump -Fc humint_platform >"$f"
    chmod 600 "$f"
    echo "Database dumped to $f"
    case "$dir" in "$HUMINT_DATA"*) ;; *)
        echo "Note: $dir is outside the encrypted store — this copy is NOT encrypted.";;
    esac
    echo "(Uploaded files are in $HUMINT_DATA/uploads; the console's own Backup"
    echo " page exports database + files together.)"
}

set_setting() {  # set_setting KEY VALUE — in the saved config and the store's settings
    local k="$1" v="$2" f
    for f in "$HUMINT_ENV" "$APP_ENV"; do
        [ -f "$f" ] || continue
        if grep -q "^${k}=" "$f"; then sed -i "s|^${k}=.*|${k}=${v}|" "$f"
        else printf '%s=%s\n' "$k" "$v" >>"$f"; fi
    done
}

cmd_tls() {
    case "${1:-}" in
        "")
            echo "HTTPS    : ${TLS:-on}"
            if [ "${TLS:-on}" = on ]; then
                echo "CA       : $(/opt/humint/bin/humint-tls.sh fingerprint 2>/dev/null || echo 'not created yet — unlock first')"
                [ -f "$HUMINT_STATE/ca.fingerprint.sha1" ] && echo "SHA-1    : $(cat "$HUMINT_STATE/ca.fingerprint.sha1")  (what Windows shows)"
                if [ -f "$HUMINT_DATA/tls/server.crt" ]; then
                    openssl x509 -in "$HUMINT_DATA/tls/server.crt" -noout -enddate -ext subjectAltName 2>/dev/null |
                        sed 's/^notAfter=/Expires  : /; s/^ *DNS/Covers   : DNS/' | grep -v "Subject Alternative"
                fi
                echo "Devices install the CA once from http://${HOSTNAME}.local/trust"
            fi ;;
        renew) /opt/humint/bin/humint-tls.sh renew; echo "New server certificate issued." ;;
        on|off)
            data_ready || die "unlock the case file first"
            set_setting TLS "$1"
            set_setting SESSION_COOKIE_SECURE "$([ "$1" = on ] && echo true || echo false)"
            systemctl restart humint-api.service
            if [ "$1" = on ]; then systemctl start humint-http.service; else systemctl stop humint-http.service; fi
            echo "HTTPS $1. Console: $(TLS=$1 console_url)" ;;
        *) die "tls needs: (nothing) | renew | on | off" ;;
    esac
}

cmd_logs() {
    case "${1:-api}" in
        firstboot) tail -n 200 -F "$HUMINT_STATE/firstboot.log" ;;
        unlock)    journalctl -u humint-unlock -n 200 -f ;;
        db)        journalctl -u "$PG_UNIT" -n 200 -f ;;
        api|worker|http|panel|battery) journalctl -u "humint-$1" -n 200 -f ;;
        *) die "logs needs: api | worker | http | panel | battery | db | firstboot | unlock" ;;
    esac
}

main() {
    local c="${1:-status}"; shift || true
    case "$c" in
        status)   cmd_status ;;
        url)      cmd_status | awk -F': ' '/^URL/{print $2}' ;;
        screen)   oled "$@" ;;
        up)       cmd_up "$@" ;;
        down)     need_root "$@"; systemctl stop humint.target humint-api humint-worker "$PG_UNIT" ;;
        restart)  need_root "$@"; systemctl restart humint-api humint-worker ;;
        backup)   cmd_backup "$@" ;;
        lock)     cmd_lock "$@" ;;
        net)      cmd_net "$@" ;;
        pin)      cmd_pin "$@" ;;
        duress)   cmd_duress "$@" ;;
        wipe)     cmd_wipe "$@" ;;
        login-password)
                  pw="$(new_login_password)"
                  printf 'Login %s, new password: %s\n' "$(login_user)" "$pw" ;;
        tls)      cmd_tls "$@" ;;
        battery)  /opt/humint/venv/bin/python3 /opt/humint/bin/humint-battery.py --once ;;
        screen-detect) /usr/bin/python3 /opt/humint/bin/humint-display.py detect --explain ;;
        shutdown) need_root "$@"; systemctl poweroff ;;
        reboot)   need_root "$@"; systemctl reboot ;;
        logs)     cmd_logs "$@" ;;
        -h|--help|help) usage ;;
        *) usage; exit 2 ;;
    esac
}

main "$@"
