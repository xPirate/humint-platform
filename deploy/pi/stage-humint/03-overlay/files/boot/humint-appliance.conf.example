# HUMINT field server — appliance configuration
#
# Edit this file BEFORE the first boot, then rename it to
#   humint-appliance.conf
# on the card's boot partition (the small FAT partition you can read on any
# computer; on Raspberry Pi OS it is mounted at /boot/firmware on the Pi).
#
# The first boot reads this once, sets the device up, and renames it to
# humint-appliance.conf.done so your Wi-Fi passphrase is not left sitting on
# a partition any computer can read. The network settings can be changed
# later with `humint-ctl net` on the device.
#
# The first boot needs NO internet: the console is already on the card.
#
# This is sourced as a shell file: KEY=value, no spaces around =, quote any
# value with spaces.

# ---- identity -------------------------------------------------------------
# The device's name on the network. Phones reach the console at
# http://<HOSTNAME>.local as well as by IP.
HOSTNAME=humint
# Shown in the console's top bar and on exported reports.
INSTANCE_NAME="HUMINT Field Server"
TIMEZONE=UTC

# ---- Wi-Fi regulatory domain ---------------------------------------------
# REQUIRED to run the hotspot. Two-letter country code (US, GB, DE, …). A Pi
# will not transmit on Wi-Fi at all until it knows which country's rules to
# follow.
WIFI_COUNTRY=US

# ---- how the team connects in the field ----------------------------------
# hotspot : the Pi's own Wi-Fi is the access point the team joins.
# client  : the Pi joins an existing Wi-Fi (e.g. a hotel network) and serves
#           the console on it. No access point.
# wired   : Ethernet only; Wi-Fi left off. Plug the Pi into a switch.
NET_MODE=hotspot

# -- hotspot settings (NET_MODE=hotspot) --
AP_SSID=humint-field
# 8–63 characters. Change this before you deploy.
AP_PSK=changeme-now
# bg = 2.4 GHz (longer range, slower). a = 5 GHz (shorter range, faster).
AP_BAND=bg
AP_CHANNEL=6
# true hides the network name; the team must type the SSID to join.
AP_HIDDEN=false

# -- client settings (NET_MODE=client) --
CLIENT_SSID=
CLIENT_PSK=

# -- wired settings (NET_MODE=wired) --
# true: the Pi hands out addresses on its Ethernet port, so a switch full of
#       laptops gets on the network with no other kit. false: the Pi expects
#       to receive an address from a router already on the wire.
WIRED_DHCP_SERVER=true

# ---- the case file's encrypted store -------------------------------------
# All case data (the database, its settings, uploaded files, map packs)
# lives in one
# encrypted volume this large. It is created once, at setup, and cannot be
# grown later without rebuilding, so size it for the deployment. Suffix with
# G for gigabytes. Leave room on the card for the OS (about 4 GB) beside it.
DATA_SIZE=16G

# ---- HTTPS ----------------------------------------------------------------
# on  : the console is served over HTTPS (port 443) with a certificate the
#       box issues itself. Each phone and laptop installs the box's
#       certificate ONCE, from http://<HOSTNAME>.local/trust (the screen and
#       `humint-ctl tls` show its fingerprint to check). That certificate is
#       restricted to local names and private addresses, so it cannot be
#       used to impersonate any other site. Port 80 then only hands out the
#       certificate and redirects to https://.
# off : plain HTTP on API_PORT, as on a home LAN.
TLS=on

# The plain-HTTP port, used only with TLS=off. 80 lets phones use
# http://<ip> with no port.
API_PORT=80

# ---- screens ---------------------------------------------------------------
# What is attached, and so what the box shows:
#   auto     : find out (default). An HDMI/DSI screen gets the touch control
#              panel; an SSD1306 OLED gets the status pages; both if both.
#   elecrow5 : the 5" 800x480 HDMI screen with resistive touch on the GPIO
#              header (Elecrow; also the Waveshare 5" (B) and others wired
#              the same way). Set this if auto does not find it — these
#              screens often do not identify themselves. The box sets up the
#              touch driver and reboots once on first boot.
#   hdmi     : any other HDMI or DSI screen (official Pi Touch Display,
#              USB-touch HDMI screens).
#   oled     : only the 0.96" OLED.
#   none     : no screen; the PIN is typed blind on the keyboard.
# With a touch screen the PIN is entered on screen, so no keyboard is needed
# in the field. Calibrate a resistive screen once: Menu → Calibrate touch.
SCREEN=auto
# The OLED on its own: auto / ssd1306 / none.
OLED=auto
# Seconds each OLED status page stays up before the next.
STATUS_ROTATE_SECONDS=6
# Blank the touch screen after this many idle minutes (0 = never). A touch
# wakes it. Saves battery.
SCREEN_SLEEP_MINUTES=5
# 180 if the screen is mounted upside down in its case.
SCREEN_ROTATE=0

# ---- battery ---------------------------------------------------------------
#   auto      : use whichever UPS board is fitted (default)
#   x1203     : require the Geekworm X1203 (Pi 5) — a real fuel gauge at I2C
#               0x36 and a power-loss pin, so the charge and "on battery" are
#               read, not guessed
#   waveshare : require the Waveshare UPS HAT (charge estimated from voltage)
#   none      : no gauge
# The screens show the charge, and a plug while on wall power. With no battery
# module they show just the plug: pulling the cable turns the box off. When
# the charge falls to BATTERY_SHUTDOWN_PERCENT on battery power (or an X1203
# cell to 3.20 V), the box stops the console, re-locks the case file and
# powers off cleanly rather than dying mid-write.
BATTERY=auto
BATTERY_SHUTDOWN_PERCENT=8
# Waveshare only: 18650 cells in series — 2 for the UPS HAT / UPS HAT (B),
# 1 for UPS HAT (C).
BATTERY_CELLS=2
# X1203 only: the power-loss pin, and its level while wall power is present.
# If the screen says "on battery" while plugged in, set the level to 0.
BATTERY_PLD_GPIO=6
BATTERY_PLD_AC_LEVEL=1
# Optional push-button for the screen: the BCM GPIO number it is wired to
# (button between that pin and ground). A tap shows the next page; holding it
# for 2 seconds shuts the box down safely. Leave empty for no button.
# (Not GPIO 25 with the 5" touch screen — its touch controller uses it.)
STATUS_BUTTON_GPIO=
