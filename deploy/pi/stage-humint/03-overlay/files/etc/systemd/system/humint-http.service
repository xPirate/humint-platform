[Unit]
Description=HUMINT field server — port 80: CA certificate download and redirect to HTTPS
PartOf=humint.target
After=humint-api.service
ConditionPathExists=/run/humint-data.ready

[Service]
Type=simple
User=humintd
Group=humintd
EnvironmentFile=/srv/humint-data/humint.env
# Only when TLS is on; with it off the console itself is on port 80.
ExecCondition=/bin/sh -c '[ "$${TLS:-on}" = on ]'
ExecStart=/usr/bin/python3 /opt/humint/bin/humint-http.py
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
Restart=always
RestartSec=3

[Install]
WantedBy=humint.target
