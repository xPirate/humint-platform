[Unit]
Description=HUMINT field server — web console and API
PartOf=humint.target
Requires=postgresql@16-main.service
After=postgresql@16-main.service
# Refuse to run against a locked store.
ConditionPathExists=/run/humint-data.ready

[Service]
Type=simple
User=humintd
Group=humintd
# Settings and the database password live INSIDE the encrypted store.
EnvironmentFile=/srv/humint-data/humint.env
WorkingDirectory=/opt/humint-platform/api
# With TLS on (the default): make sure the certificate exists and covers this
# box's current addresses — as root ("+"), since the CA key is root-only —
# then serve HTTPS on 443. humint-api-run picks HTTPS or HTTP from TLS=.
# Where a signed-in browser's clock is left for humint-clock to apply (the box
# has no clock of its own worth trusting; see api/clock.py).
ExecStartPre=+/usr/bin/install -d -m 750 -o humintd -g humintd /srv/humint-data/clock /srv/humint-data/updates
ExecStartPre=+/bin/sh -c 'if [ "$${TLS:-on}" = on ]; then /opt/humint/bin/humint-tls.sh ensure; fi'
ExecStart=/opt/humint/bin/humint-api-run
# Lets an unprivileged account serve on 443 (or 80), so phones need no :port.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Scratch files (backup bundles, OCR pages) hold case data too: keep them
# inside the encrypted store, never on the plain SD card.
Environment=TMPDIR=/srv/humint-data/tmp
Environment=CLOCK_HINT_FILE=/srv/humint-data/clock/hint.json
# Where an admin's uploaded update bundle is left for humint-update-inbox.
Environment=UPDATE_INBOX=/srv/humint-data/updates/incoming.tar
ReadWritePaths=/srv/humint-data/uploads /srv/humint-data/map-packs /srv/humint-data/tmp -/srv/humint-data/clock -/srv/humint-data/updates
Restart=always
RestartSec=3

[Install]
WantedBy=humint.target
