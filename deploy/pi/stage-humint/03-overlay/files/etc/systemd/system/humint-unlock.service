[Unit]
Description=HUMINT field server — unlock the encrypted case store
# Only once the store exists (first boot creates it and starts up by itself).
ConditionPathExists=/var/lib/humint/firstboot.done
After=humint-firstboot.service systemd-user-sessions.service
# Owns the keyboard for the PIN prompt, so no login prompt fights it.
Conflicts=getty@tty1.service
Before=getty@tty1.service humint-compose.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
StandardInput=tty-force
StandardOutput=tty
StandardError=journal+console
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
ExecStart=/opt/humint/bin/humint-unlock.sh
# No timeout: the box may sit at the PIN prompt until someone is there to type.
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
