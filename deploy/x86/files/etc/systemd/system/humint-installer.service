[Unit]
Description=HUMINT field server — install from the USB stick
# Only on the stick's live system (its GRUB menu adds humint.install).
ConditionKernelCommandLine=humint.install
After=systemd-udev-settle.service systemd-user-sessions.service
Conflicts=getty@tty1.service
Before=getty@tty1.service

[Service]
Type=oneshot
Environment=TERM=linux
StandardInput=tty-force
StandardOutput=tty
# The screen, not the log: whiptail draws its dialogs on stderr (the
# installer swaps its streams to read the answer), and pv its progress.
# Sent to the journal they never appeared — the disk menu came out as lines
# of log on the console. The installer keeps its own log in /run.
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
ExecStart=/opt/humint/bin/humint-install.sh
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
