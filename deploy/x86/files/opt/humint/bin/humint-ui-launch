#!/bin/sh
# Starts the screen: the cage compositor showing only the native app.
#
# Drawing normally uses the machine's graphics chip. Some machines have one
# the drivers handle badly (or none at all, like most virtual machines), and
# the screen then crashes as it starts. So each start-up crash is counted,
# and after two in a row the screen draws in software instead: a little
# slower, works everywhere. A run that lasts past a minute clears the count.
#
# HUMINT_RENDER in humint-appliance.conf: auto (the above), gpu, software.
#
#   --prepare   root, before each start (ExecStartPre=+): decide how to draw
#   (none)      the screen's own account: start cage and the app
#   --stopped   root, after each stop (ExecStopPost=+): count a crash
RUN=/run/humint
COUNT=$RUN/ui-crashes
MODE=$RUN/ui-render
STARTED=$RUN/ui-started

num() { v=$(cat "$1" 2>/dev/null); case "$v" in ''|*[!0-9]*) echo 0 ;; *) echo "$v" ;; esac; }

case "${1:-}" in
--prepare)
    mkdir -p "$RUN"
    setting=$(sed -n 's/^HUMINT_RENDER=//p' /var/lib/humint/env 2>/dev/null | tail -1 | tr -d "\"' ")
    case "$setting" in gpu|software) ;; *) setting=auto ;; esac
    mode=gpu
    if [ "$setting" = software ] || { [ "$setting" = auto ] && [ "$(num "$COUNT")" -ge 2 ]; }; then
        mode=software
    fi
    echo "$mode" >"$MODE"
    date +%s >"$STARTED"
    chmod 644 "$MODE" "$STARTED"
    exit 0
    ;;
--stopped)
    mkdir -p "$RUN"
    n=$(num "$COUNT")
    # Fallen back already: stay in software until reboot. Going back to the
    # graphics chip after a clean restart would only crash twice more.
    [ "$n" -ge 2 ] && exit 0
    ran=$(( $(date +%s) - $(num "$STARTED") ))
    case "${SERVICE_RESULT:-}" in
        signal|core-dump|exit-code) if [ "$ran" -lt 60 ]; then n=$((n + 1)); else n=0; fi ;;
        *) n=0 ;;
    esac
    echo "$n" >"$COUNT"
    if [ "$n" -eq 2 ]; then
        echo "humint-ui: the screen crashed twice starting up; drawing in software from now on (until reboot)" >&2
    fi
    exit 0
    ;;
esac

if [ "$(cat "$MODE" 2>/dev/null)" = software ]; then
    export WLR_RENDERER=pixman
    export QT_QUICK_BACKEND=software
    export LIBGL_ALWAYS_SOFTWARE=1
    echo "humint-ui: drawing in software" >&2
fi
exec /usr/bin/cage -d -s -- /opt/humint/ui-venv/bin/python -m humint_ui
